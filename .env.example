# ==============================================================================
# MedPulse — Fullstack Clinical LMS & AI Tutor (Monorepo Root Environment)
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (Strictly enforced for CORS origin whitelist in production)
CLIENT_URL=http://localhost:5173

# Dev/Mock Auth Flag
# MUST be false or unset in production. If set to true when NODE_ENV=production, server fails startup.
ALLOW_DEV_AUTH=false

# ------------------------------------------------------------------------------
# Primary Administrator Credentials (MANDATORY FOR DATABASE SEEDING)
# Hardcoded credentials are strictly prohibited. The seed script fails if not set.
# ------------------------------------------------------------------------------
ADMIN_NAME=MedPulse System Administrator
ADMIN_EMAIL=admin@medpulse.edu
ADMIN_PASSWORD=change_this_strong_admin_password_2026!

# Secondary Administrator Credentials (Optional)
SECONDARY_ADMIN_NAME=MedPulse Secondary Administrator
SECONDARY_ADMIN_EMAIL=admin2@medpulse.edu
SECONDARY_ADMIN_PASSWORD=change_this_secondary_admin_password!

# Optional Seed Credentials for Demo Faculty & Student
SEED_FACULTY_PASSWORD=FacultySecurePass!2026
SEED_STUDENT_PASSWORD=StudentSecurePass!2026

# ------------------------------------------------------------------------------
# Database & Authentication Secrets
# ------------------------------------------------------------------------------
# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medpulse_lms?retryWrites=true&w=majority

# JWT HMAC Secret Key (Mandatory in production)
JWT_SECRET=your_ultra_secure_jwt_secret_key_minimum_32_characters_here

# Firebase Admin SDK Configuration
# Provide project ID and either JSON string or path to serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# Google Gemini & RAG Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chapter Retrieval & Quota Thresholds
DAILY_RAG_USER_QUOTA=50
RAG_CONFIDENCE_THRESHOLD=0.20

# ------------------------------------------------------------------------------
# Upstash Redis & Rate Limiting (Optional - Falls back to resilient in-memory store)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite Environment Mirrors)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
