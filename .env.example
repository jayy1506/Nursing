# ==========================================
# Root Environment Configuration Template
# MedPulse — Clinical LMS Monorepo Workspace
# ==========================================

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Admin Accounts
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_in_production

SECONDARY_ADMIN_NAME=Secondary Admin
SECONDARY_ADMIN_EMAIL=admin2@example.com
SECONDARY_ADMIN_PASSWORD=change_this_admin2_password_in_production

# Frontend mirrors
VITE_ADMIN_NAME=Admin User
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change_this_admin_password_in_production

VITE_SECONDARY_ADMIN_NAME=Secondary Admin
VITE_SECONDARY_ADMIN_EMAIL=admin2@example.com
VITE_SECONDARY_ADMIN_PASSWORD=change_this_admin2_password_in_production

# Database & Security
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_strong_secret_key_change_in_production
FIREBASE_PROJECT_ID=your-firebase-project-id

# AI Providers
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Frontend Firebase & API
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
