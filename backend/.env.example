# ==============================================================================
# MedPulse — Backend Service Environment Template
# Duplicate this file to backend/.env and populate with production/dev secrets.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# Client Application URL (For strict CORS whitelist enforcement)
CLIENT_URL=http://localhost:5173

# Dev/Mock Auth Flag
# MUST be false or unset in production. If true in production, backend refuses startup.
ALLOW_DEV_AUTH=false

# ------------------------------------------------------------------------------
# Primary Administrator Credentials (MANDATORY FOR DATABASE SEEDING)
# ------------------------------------------------------------------------------
ADMIN_NAME=MedPulse System Administrator
ADMIN_EMAIL=admin@medpulse.edu
ADMIN_PASSWORD=change_this_strong_admin_password_2026!

# Secondary Administrator Credentials (Optional)
SECONDARY_ADMIN_NAME=MedPulse Secondary Administrator
SECONDARY_ADMIN_EMAIL=admin2@medpulse.edu
SECONDARY_ADMIN_PASSWORD=change_this_secondary_admin_password!

# Optional Seed Credentials for Demo Accounts
SEED_FACULTY_PASSWORD=FacultySecurePass!2026
SEED_STUDENT_PASSWORD=StudentSecurePass!2026

# ------------------------------------------------------------------------------
# Database & Authentication Secrets
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/medpulse_lms?retryWrites=true&w=majority
JWT_SECRET=your_ultra_secure_jwt_secret_key_minimum_32_characters_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to serviceAccountKey.json or raw JSON string
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# ------------------------------------------------------------------------------
# Google Gemini & RAG Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chapter Retrieval & Quota Thresholds
DAILY_RAG_USER_QUOTA=50
RAG_CONFIDENCE_THRESHOLD=0.20

# ------------------------------------------------------------------------------
# Upstash Redis & Rate Limiting (Optional - in-memory fallback enabled)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://<your-database>.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
