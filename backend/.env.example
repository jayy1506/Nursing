# ==========================================
# Backend Environment Configuration Template
# Duplicate this file to .env and fill in real values
# ==========================================

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Primary Administrator Credentials (Initial Seed)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password_in_production

# Secondary Administrator Credentials
SECONDARY_ADMIN_NAME=Secondary Admin
SECONDARY_ADMIN_EMAIL=admin2@example.com
SECONDARY_ADMIN_PASSWORD=change_this_admin2_password_in_production

# Database Connection (MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>?retryWrites=true&w=majority

# Authentication Secret (HMAC-SHA256 for JWT)
JWT_SECRET=your_jwt_strong_secret_key_change_in_production

# Firebase Admin Configuration (Optional: Path to serviceAccountKey.json or project ID)
FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT=./serviceAccountKey.json

# Google Gemini API (Dynamic RAG & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
