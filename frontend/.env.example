# ==========================================
# Frontend Environment Configuration Template
# Duplicate this file to .env and fill in real values
# ==========================================

# Administrator Credentials (Dev / Demo Shortcuts)
VITE_ADMIN_NAME=Admin User
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change_this_admin_password_in_production

# Secondary Administrator Credentials
VITE_SECONDARY_ADMIN_NAME=Secondary Admin
VITE_SECONDARY_ADMIN_EMAIL=admin2@example.com
VITE_SECONDARY_ADMIN_PASSWORD=change_this_admin2_password_in_production

# Backend API Base URL (Leave empty in local development to use Vite proxy /api)
VITE_API_BASE_URL=

# Firebase Client Configuration (Web SDK)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Google Gemini API (AI Clinical Tutor)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
VITE_GEMINI_MODEL=gemini-1.5-flash

# OpenAI / Fallback AI Service (Optional)
VITE_OPENAI_API_KEY=
VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions
VITE_OPENAI_MODEL=gpt-3.5-turbo
